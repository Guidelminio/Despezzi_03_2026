# Endereço público da aplicação; usado no callback Google e nos links de redefinição.
APP_URL=http://localhost:3000
PORT=3000
APP_TIME_ZONE=America/Sao_Paulo
DATABASE_PATH=./database.sqlite

# E-mail transacional. Deixe SMTP_USER e SMTP_PASS vazios até configurar credenciais reais.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Despezi <contato@despezi.com>"

# OAuth Google opcional. Configure credenciais do Google Cloud se for usar login social.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
