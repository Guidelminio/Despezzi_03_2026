# Origem usada em callbacks/links; a apresentação LAN desativa OAuth e não depende deste valor.
APP_URL=http://localhost:3000
PORT=3000
# O padrão do servidor é 127.0.0.1; somente o runner de apresentação abre o bind na LAN.
HOST=127.0.0.1
DEMO_MODE=false
APP_TIME_ZONE=America/Sao_Paulo
DATABASE_PATH=./database.sqlite
# Opcional: caminho do Python 3 sem argumentos. Padrão: python3 (Linux/macOS) ou python (Windows).
PYTHON_EXECUTABLE=

# E-mail transacional. Deixe SMTP_USER e SMTP_PASS vazios até configurar credenciais reais.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Despezi <contato@despezi.com>"

# OAuth Google opcional. Configure credenciais do Google Cloud se for usar login social.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
